{
  "rules": {
    ".read": "auth != null && root.child('equipo').child(auth.uid).val() === true",
    ".write": "auth != null && root.child('equipo').child(auth.uid).val() === true",
    "portalUxcar": {
      ".read": "auth != null && root.child('portalUsuarios').child(auth.uid).exists()",
      ".write": "auth != null && root.child('portalUsuarios').child(auth.uid).exists()"
    },
    "portalUsuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    }
  }
}
